# Supabase Connection settings (required for auth verification & DB)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Service Role Key (Backend ONLY. Never expose to frontend/browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-private-key

# Supabase JWT Secret (Optional, used for local offline JWT validation.
# Find this in Supabase Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-used-to-sign-tokens

# List of emails authorized to access administrative console actions (comma-separated)
CONSOLE_ADMIN_EMAILS=admin@example.com

